# MongoDB connection string. Set this to your own database when running locally,
# for example MONGODB_URI=mongodb://localhost:27017
MONGODB_URI=

# Database name used inside that MongoDB server.
MONGODB_DB=notes

# Comma-separated list of frontend origins allowed to call the API. Leave it unset to allow any origin.
FRONTEND_URL=http://localhost:5173

# Port the Express server listens on.
PORT=3000

# Logging verbosity level (e.g. debug, info, warn, error).
LOG_LEVEL=info
